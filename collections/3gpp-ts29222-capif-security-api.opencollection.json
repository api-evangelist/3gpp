              {
                "name": "apiInvokerId",
                "value": "",
                "type": "path",
                "description": "Identifier of an individual API invoker"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a security context for individual API invoker."
        },
        {
